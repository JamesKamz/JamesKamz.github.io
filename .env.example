# ─── Site ───────────────────────────────────────────────────────────────
# Public canonical URL (no trailing slash) — used for SEO, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://jameskamz.com

# ─── Database (PostgreSQL — Neon or Supabase) ───────────────────────────
# Neon: use the *pooled* connection string for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Auth.js (admin dashboard) ──────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Required behind proxies other than Vercel
# AUTH_TRUST_HOST=true
# Admin account created by `npx prisma db seed` (password ≥ 12 chars)
ADMIN_EMAIL=jameskamzk@gmail.com
ADMIN_PASSWORD=
# Optional GitHub OAuth login (restricted to ADMIN_GITHUB_LOGIN)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGIN=JamesKamz

# ─── Emails (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Recipient of contact / quote notifications
CONTACT_TO_EMAIL=jameskamzk@gmail.com
# Verified sender on your Resend domain
CONTACT_FROM_EMAIL="Portfolio James Kamz <noreply@jameskamz.com>"

# ─── Chatbot (Anthropic Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model used by /api/chat
ANTHROPIC_MODEL=claude-opus-5-5

# ─── YouTube Data API v3 (optional — section falls back gracefully) ─────
YOUTUBE_API_KEY=

# ─── Uploads (Vercel Blob — required for image uploads in production) ───
BLOB_READ_WRITE_TOKEN=
